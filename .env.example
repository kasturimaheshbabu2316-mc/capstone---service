MOCK_LLM=true
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_REQUEST_TOKENS=1500
CHROMA_DIR=./chroma_store
LOG_FILE=./logs/requests.jsonl
DATABASE_URL=sqlite:///./data/support.db
BACKEND_URL=http://127.0.0.1:8000
MAX_QUERY_TOKENS=2000
# Admin authentication token for privileged endpoints (/add-document, /clear-cache)
ADMIN_TOKEN=change-me-demo-token
# LLM Provider Switch: mock (default, offline) | ollama | gemini
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
